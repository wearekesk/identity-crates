<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The chip read needs NFC, so the plugin declares it: no app using this can do
         without it.

         INTERNET is deliberately not declared. Nothing here reaches the network by
         default — the CRL fetch needs an HTTP client the app supplies — and a plugin
         that quietly adds internet access to every consumer is not a good citizen. An
         app that enables revocation checking declares it itself. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
